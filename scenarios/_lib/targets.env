# targets.env — alamat, service, kredensial lab (SINTETIS, lab terisolasi).
# Semua kredensial di sini memang lemah & publik di dokumen: ini target
# brute-force/credential-dumping di lab tertutup, BUKAN kredensial produksi.
# Di-source oleh _lib/common.sh. Ubah di sini saja kalau topologi berubah.

# --- attacker (sumber semua serangan) ---
ATTACKER_IP=10.10.30.10
ATTACKER_GW=10.10.30.1

# --- target server (intnet-server, selalu nyala) ---
SRV_WEB=10.10.10.10      # DVWA via Docker :80, SSH :22
SRV_FILE=10.10.10.11     # SSH :22, FTP(vsftpd) :21, SMB(samba) :445

# --- target client Linux (intnet-client, HANYA Linux phase) ---
CLIENT1=10.10.20.20
CLIENT2=10.10.20.21

# --- target Windows (intnet-client, HANYA Windows phase) ---
WIN=10.10.20.50          # RDP :3389, WinRM :5985, SMB :445

# --- kredensial lab Linux (labadmin/labadmin) ---
LIN_USER=labadmin
LIN_PASS=labadmin
SMB_SHARE_LINUX=labshare # //SRV_FILE/labshare

# --- kredensial lab Windows (dari Phase 4) ---
WIN_USER=admin_lab       # anggota Administrators
WIN_PASS=Admin@2024
WIN_USER2=labuser
WIN_PASS2=P@ssw0rd123
WIN_SHARE=LabShare       # //WIN/LabShare

# --- DVWA (S04). Isi cookie dari sesi login DVWA (security=low) biar sqlmap
#     bisa masuk ke endpoint ber-auth. Kosongkan -> skrip hanya kirim burst
#     payload via curl (tetap menghasilkan trafik injection di kabel). ---
DVWA_URL="http://${SRV_WEB}/vulnerabilities/sqli/"
DVWA_COOKIE=""           # contoh: "PHPSESSID=xxxx; security=low"

# --- S09 iodine DNS tunneling ---
IODINE_SERVER=${SRV_FILE}   # host yang menjalankan iodined (lihat PREREQ di run.sh)
IODINE_DOMAIN=tunnel.lab.local
IODINE_PASS=labtunnel

# --- wordlist (relatif ke _lib) ---
USERLIST="users.txt"
PASSLIST="pass.txt"

# --- marker log (CSV) untuk pelabelan; dibuat di home user attacker ---
MARKER_LOG="${HOME}/attack-markers.csv"
